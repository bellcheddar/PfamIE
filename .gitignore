# Environments
.venv/
__pycache__/
*.pyc

# Forge working data: all of it is regenerated by forge/build_assets.py
assets/raw/
assets/build/
assets/coreml/
assets/bundle/

# SwiftPM build products. `build/` alone does not cover this: SwiftPM uses a
# dot-prefixed `.build/`, and missing it committed 4,836 files and 146 MB of
# module caches before the first push, which is what made that push hang.
.build/
.swiftpm/
Package.resolved

# Xcode
*.xcuserstate
xcuserdata/
DerivedData/
build/
.DS_Store
PfamIE.xcodeproj/
