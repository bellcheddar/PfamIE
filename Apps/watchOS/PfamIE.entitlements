<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The watch app writes the last result here and the complication reads
         it. Without a shared group the extension has its own container and the
         complication shows a placeholder forever. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.mdeller.pfamie</string>
    </array>
</dict>
</plist>
